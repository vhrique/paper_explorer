# Copy this to .env and fill in your values.

DATABASE_URL=postgresql://user:password@localhost:5432/paper_explorer

# Storage: 'local' for dev, 'gcs' for production
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
# GCS_BUCKET_NAME=paper-explorer

# Embeddings — point to LM Studio or any OpenAI-compatible provider
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=lm-studio
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# LLM — same pattern
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen/qwen3-vl-4b
